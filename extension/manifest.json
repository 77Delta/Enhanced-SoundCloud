{
  "manifest_version": 3,
  "name": "Enhanced SoundCloud",
  "version": "1.0",
  "description": "An extension for SoundCloud that adds lyrics, background music videos, a playback speed changer, a song downloader, a debloater and more.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
