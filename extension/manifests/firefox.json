{
  "manifest_version": 3,
  "name": "Enhanced SoundCloud",
  "version": "1.0.0",
  "description": "An extension for SoundCloud that adds lyrics, background music videos, a playback speed changer, a song downloader and more.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "host_permissions": ["https://soundcloud.com/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["https://soundcloud.com/*"], "js": ["main.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true },
    { "matches": ["https://soundcloud.com/*"], "js": ["relay.js"], "run_at": "document_start" }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "enhanced-soundcloud@77delta",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  }
}
